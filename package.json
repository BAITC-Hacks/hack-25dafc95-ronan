{
  "name": "ekt-assistant",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev:api": "npm run dev -w @ekt/api",
    "build": "npm run build -w @ekt/api",
    "typecheck": "npm run typecheck -w @ekt/api",
    "lint": "npm run lint -w @ekt/api",
    "test": "npm run test -w @ekt/api",
    "test:integration": "npm run test:integration -w @ekt/api",
    "db:migrate": "npm run db:migrate -w @ekt/api",
    "db:seed-fixtures": "npm run db:seed-fixtures -w @ekt/api"
  }
}
