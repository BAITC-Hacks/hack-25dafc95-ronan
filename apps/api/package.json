{
  "name": "@ekt/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --testTimeout 15000 --maxWorkers 2",
    "test:integration": "vitest run src/cart/cart.integration.test.ts --testTimeout 15000 --maxWorkers 2",
    "db:migrate": "npm run build && node dist/db/migrate.js",
    "db:seed-fixtures": "npm run build && node dist/db/seed-fixtures.js"
  },
  "dependencies": {
    "@fastify/swagger": "^9.0.0",
    "@fastify/type-provider-zod": "1.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.0.0",
    "openapi-types": "^12.1.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
